{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Wanderer",
	"version": "0.4.4",
	"identifier": "network.wanderer.app",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://127.0.0.1:1420/",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: wss:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; frame-src https:"
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"deb"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"license": "MPL-2.0",
		"licenseFile": "../../LICENSE",
		"homepage": "https://wanderer.singula.network",
		"shortDescription": "Private, unblocked internet on the Singula network",
		"linux": {
			"deb": {
				"depends": [
					"nftables",
					"systemd"
				],
				"files": {
					"/usr/lib/wanderer/wandererd": "../../target/release/wandererd",
					"/usr/lib/wanderer/xray": "../../target/xray/xray",
					"/usr/lib/systemd/system/wandererd.service": "deb/wandererd.service"
				},
				"postInstallScript": "deb/postinst",
				"preRemoveScript": "deb/prerm",
				"postRemoveScript": "deb/postrm"
			}
		}
	},
	"plugins": {
		"deep-link": {
			"mobile": [
				{
					"scheme": ["singula"],
					"host": "oauth",
					"appLink": false
				}
			]
		},
		"shell": {
			"open": "^(wc|metamask|rainbow|trust|cbwallet|uniswap|zerion|imtoken|tokenpocket|safepal):"
		}
	}
}
