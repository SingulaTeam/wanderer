[Unit]
Description=Wanderer tunnel service
Documentation=https://wanderer.singula.network
# The guard must be up before anything else reaches the network on boot.
After=network-pre.target nss-lookup.target
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/lib/wanderer/wandererd --xray /usr/lib/wanderer/xray
Restart=on-failure
RestartSec=2
# The control socket's directory, created for the service and removed with it.
RuntimeDirectory=wanderer
RuntimeDirectoryMode=0755

# It needs the network and nothing else: TUN devices, routes, nftables, socket
# marks and binding to an interface. Root otherwise, but root with only these.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
